# Copy to .env for local dev. NEVER commit the real .env, never paste
# real tokens into chat, README or code. On Render, set these in the
# dashboard (Environment tab) instead.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=
# Example: if your bot is @MyDownloaderBot, put MyDownloaderBot (no @).
# Used only for the "Open Telegram Bot" button on expired pages.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Free from https://my.telegram.org/apps — needed for the Local Bot API
# server (download unlimited, up to 4 GB). Without these, the app still
# runs but only in hosted mode (getFile limit 20 MB).

BASE_URL=http://localhost:10000
# On Render after first deploy, set this to your service URL, e.g.
# https://telegram-downloader-bot.onrender.com (no trailing slash).

# LOCAL_BOT_API_URL=http://127.0.0.1:8081
# Leave empty for hosted mode. start.sh sets it automatically on Render
# when the local server starts. In docker-compose it is set to
# http://telegram-bot-api:8081.

PORT=10000
